@using Microsoft.AspNetCore.Http
@{
    int? usuarioId = Context.Session.GetInt32("UsuarioId");
    string? usuarioNombre = Context.Session.GetString("UsuarioNombre");
    string? usuarioRol = Context.Session.GetString("UsuarioRol");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GarAngelito Tools Pro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- LOADER GLOBAL -->
    <div id="global-loader" class="loader-overlay d-none">
        <div class="card-minimal p-4 text-center shadow-sm">
            <div class="spinner-border text-dark mb-2" role="status"></div>
            <div id="loader-text" class="small fw-medium text-muted">Conectando con GarAngelitoToolsProDB...</div>
        </div>
    </div>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-3 mb-4 sticky-top">
        <div class="container">
            <a class="navbar-brand fw-semibold d-flex align-items-center gap-2" asp-controller="Home" asp-action="@(usuarioId != null ? "Index" : "Login")">
                <i class="bi bi-boxes text-dark"></i>
                <span>GarAngelito Tools Pro</span>
                <small class="badge bg-dark fw-normal" style="font-size:0.65rem;">SQL 3FN</small>
            </a>

            @if (usuarioId != null)
            {
                <div class="d-flex align-items-center gap-2 order-lg-last ms-2">
                    <span class="d-none d-md-inline-block small text-muted me-1">
                        <i class="bi bi-person-badge me-1"></i>@usuarioNombre
                        <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">@usuarioRol</span>
                    </span>
                    <button class="btn btn-light border position-relative rounded-3 px-2 py-1" type="button" data-bs-toggle="offcanvas" data-bs-target="#panelNotificaciones">
                        <i class="bi bi-bell fs-5"></i>
                        <span id="notif-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.65rem;">0</span>
                    </button>
                    <a asp-controller="Home" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-3 ms-1" title="Cerrar Sesión">
                        <i class="bi bi-box-arrow-right"></i>
                    </a>
                    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>

                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav ms-auto gap-1 me-2">
                        <li class="nav-item"><a class="nav-link px-3 rounded-3" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link px-3 rounded-3" asp-controller="Home" asp-action="Billetera">Billetera</a></li>
                        <li class="nav-item"><a class="nav-link px-3 rounded-3" asp-controller="Home" asp-action="Kanban">Tareas</a></li>
                        <li class="nav-item"><a class="nav-link px-3 rounded-3" asp-controller="Home" asp-action="Horario">Horario</a></li>
                        <li class="nav-item"><a class="nav-link px-3 rounded-3" asp-controller="Home" asp-action="Apa">Citas APA</a></li>
                    </ul>
                </div>
            }
            else
            {
                <div class="ms-auto d-flex gap-2">
                    <a asp-controller="Home" asp-action="Login" class="btn btn-light border btn-sm rounded-3 px-3">Iniciar Sesión</a>
                    <a asp-controller="Home" asp-action="Registro" class="btn-dark-minimal btn-sm text-decoration-none py-1 px-3">Registro Estudiantes</a>
                </div>
            }
        </div>
    </nav>

    <main class="container pb-5">
        @RenderBody()
    </main>

    <!-- CENTRO DE NOTIFICACIONES -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="panelNotificaciones">
        <div class="offcanvas-header border-bottom">
            <h6 class="offcanvas-title fw-semibold mb-0">
                <i class="bi bi-bell me-2"></i>Notificaciones (GarAngelitoToolsProDB)
            </h6>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column p-0">
            <div class="p-2 border-bottom bg-light d-flex justify-content-between align-items-center px-3">
                <button onclick="window.UI.marcarTodasLeidas()" class="btn btn-link btn-sm text-decoration-none text-dark p-0 small">
                    <i class="bi bi-check2-all me-1"></i>Marcar todas leídas
                </button>
                <button onclick="window.UI.limpiarNotificaciones()" class="btn btn-link btn-sm text-decoration-none text-danger p-0 small">Borrar de BD</button>
            </div>
            <div id="notif-lista" class="list-group list-group-flush overflow-auto flex-grow-1"></div>
        </div>
    </div>

    <!-- TOASTS EMERGENTES -->
    <div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;"></div>

    <!-- MODAL DE EXCEPCIÓN GRÁFICA DE ERROR -->
    <div class="modal fade" id="errorModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
                <div class="bg-danger text-white p-3 text-center">
                    <i class="bi bi-exclamation-octagon-fill display-5"></i>
                    <h6 class="fw-semibold mt-2 mb-0" id="error-modal-title">Excepción SQL / Aplicación</h6>
                </div>
                <div class="modal-body text-center p-4">
                    <p class="small text-muted mb-2" id="error-modal-msg">Ha ocurrido un error inesperado.</p>
                    <code class="d-block bg-light p-2 rounded small text-danger border" id="error-modal-code">SQL_ERR</code>
                </div>
                <div class="modal-footer border-0 pt-0 justify-content-center">
                    <button type="button" class="btn btn-dark-minimal w-100" data-bs-dismiss="modal">Entendido</button>
                </div>
            </div>
        </div>
    </div>

    <footer class="text-center text-muted py-4 mt-auto border-top bg-white small">
        <div class="container">
            <strong>GarAngelito Tools Pro</strong> &bull; .NET 10 MVC + GarAngelitoToolsProDB (SQL 3FN) + Bootstrap + React + Vue
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            window.UI = {
                showLoader(texto = 'Procesando en GarAngelitoToolsProDB...') {
                    document.getElementById('loader-text').innerText = texto;
                    document.getElementById('global-loader').classList.remove('d-none');
                },
                hideLoader() {
                    document.getElementById('global-loader').classList.add('d-none');
                },
                async notify(titulo, mensaje, tipo = 'success', guardarEnSql = true) {
                    const colores = {
                        success: { icon: 'bi-check-circle-fill text-success', border: 'border-success' },
                        warning: { icon: 'bi-exclamation-triangle-fill text-warning', border: 'border-warning' },
                        danger:  { icon: 'bi-x-circle-fill text-danger', border: 'border-danger' },
                        info:    { icon: 'bi-info-circle-fill text-primary', border: 'border-primary' }
                    };
                    const cfg = colores[tipo] || colores.info;

                    const container = document.getElementById('toast-container');
                    const toastEl = document.createElement('div');
                    toastEl.className = `toast align-items-center bg-white border-0 border-start border-4 ${cfg.border} shadow-sm mb-2`;
                    toastEl.innerHTML = `
                        <div class="d-flex p-3">
                            <i class="bi ${cfg.icon} fs-5 me-3"></i>
                            <div class="me-auto">
                                <strong class="d-block small fw-semibold text-dark">${titulo}</strong>
                                <span class="small text-muted">${mensaje}</span>
                            </div>
                            <button type="button" class="btn-close ms-2 m-auto" data-bs-dismiss="toast"></button>
                        </div>
                    `;
                    container.appendChild(toastEl);
                    const bsToast = new bootstrap.Toast(toastEl, { delay: 3200 });
                    bsToast.show();
                    toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());

                    if (guardarEnSql) {
                        const res = await fetch('/Home/CrearNotificacion', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ titulo, mensaje, tipo })
                        });
                        if (res.ok) await this.renderNotificaciones();
                    }
                },
                showException(titulo, detalle, codigoError = 'SQL_ERR_50000') {
                    document.getElementById('error-modal-title').innerText = titulo;
                    document.getElementById('error-modal-msg').innerText = detalle;
                    document.getElementById('error-modal-code').innerText = codigoError;
                    const modal = new bootstrap.Modal(document.getElementById('errorModal'));
                    modal.show();
                    this.notify(titulo, `${detalle} (${codigoError})`, 'danger', true);
                },
                async renderNotificaciones() {
                    const contenedor = document.getElementById('notif-lista');
                    const badge = document.getElementById('notif-badge');
                    if (!contenedor || !badge) return;

                    const res = await fetch('/Home/ObtenerNotificaciones');
                    if (!res.ok) return;
                    const lista = await res.json();

                    const noLeidas = lista.filter(n => !n.leida).length;
                    if (noLeidas > 0) {
                        badge.innerText = noLeidas;
                        badge.classList.remove('d-none');
                    } else {
                        badge.classList.add('d-none');
                    }

                    if (lista.length === 0) {
                        contenedor.innerHTML = `<div class="text-center text-muted small py-5"><i class="bi bi-inbox fs-2 d-block mb-2"></i>Sin notificaciones en BD</div>`;
                        return;
                    }

                    const iconos = {
                        success: 'bi-check-circle-fill text-success',
                        warning: 'bi-exclamation-triangle-fill text-warning',
                        danger: 'bi-x-circle-fill text-danger',
                        info: 'bi-info-circle-fill text-primary'
                    };

                    contenedor.innerHTML = lista.map(n => `
                        <div class="list-group-item px-3 py-3 border-bottom ${!n.leida ? 'bg-light' : ''}">
                            <div class="d-flex align-items-start gap-2">
                                <input type="checkbox" class="form-check-input mt-1" ${n.leida ? 'checked' : ''} onchange="window.UI.toggleLeida(${n.id})" title="Check de lectura en BD" />
                                <i class="bi ${iconos[n.tipo] || iconos.info} mt-1"></i>
                                <div class="w-100 ${n.leida ? 'opacity-50' : ''}">
                                    <div class="d-flex justify-content-between">
                                        <strong class="small fw-semibold">${n.titulo}</strong>
                                        <span class="text-muted" style="font-size: 0.7rem;">${n.hora}</span>
                                    </div>
                                    <div class="small text-muted mt-1">${n.mensaje}</div>
                                </div>
                            </div>
                        </div>
                    `).join('');
                },
                async toggleLeida(id) {
                    await fetch(`/Home/ToggleNotificacion?id=${id}`, { method: 'POST' });
                    await this.renderNotificaciones();
                },
                async marcarTodasLeidas() {
                    await fetch('/Home/MarcarTodasLeidas', { method: 'POST' });
                    await this.renderNotificaciones();
                },
                async limpiarNotificaciones() {
                    await fetch('/Home/LimpiarNotificaciones', { method: 'POST' });
                    await this.renderNotificaciones();
                }
            };

            document.addEventListener('DOMContentLoaded', () => window.UI.renderNotificaciones());
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>