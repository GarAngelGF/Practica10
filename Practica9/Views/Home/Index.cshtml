@{
    ViewData["Title"] = "Panel Principal";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <span class="text-muted small text-uppercase fw-semibold">@ViewBag.FechaActual</span>
        <h2 class="fw-semibold mt-1 mb-1">Hola, @ViewBag.AlumnoNombre</h2>
        <p class="text-muted small mb-0 fst-italic">"@ViewBag.FraseDia"</p>
    </div>
    <div class="col-md-4 mt-3 mt-md-0">
        <div class="card-minimal p-3">
            <div class="d-flex justify-content-between small mb-1">
                <span class="text-muted">Progreso del mes</span>
                <span class="fw-semibold">@ViewBag.ProgresoMes%</span>
            </div>
            <div class="progress mb-2" style="height: 6px;">
                <div class="progress-bar bg-dark" style="width: @ViewBag.ProgresoMes%"></div>
            </div>
            <div class="text-muted" style="font-size: 0.78rem;">
                <i class="bi bi-calendar-event me-1"></i>Faltan <strong>@ViewBag.DiasRestantesMes días</strong> para que termine el mes.
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <a asp-action="Billetera" class="text-decoration-none text-dark">
            <div class="card-minimal card-minimal-hover p-4 h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <i class="bi bi-wallet2 fs-3"></i>
                </div>
                <h5 class="fw-semibold mb-1">Billetera Diaria</h5>
                <p class="text-muted small mb-0">Administra tu presupuesto diario, registra tus gastos por categoría y consulta tu historial financiero en el calendario.</p>
            </div>
        </a>
    </div>

    <div class="col-md-6">
        <a asp-action="Kanban" class="text-decoration-none text-dark">
            <div class="card-minimal card-minimal-hover p-4 h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <i class="bi bi-kanban fs-3"></i>
                </div>
                <h5 class="fw-semibold mb-1">Tablero Kanban de Tareas</h5>
                <p class="text-muted small mb-0">Organiza tus entregas y pendientes por columnas de avance, adjunta imágenes y controla listas de subtareas.</p>
            </div>
        </a>
    </div>

    <div class="col-md-6">
        <a asp-action="Horario" class="text-decoration-none text-dark">
            <div class="card-minimal card-minimal-hover p-4 h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <i class="bi bi-calendar3-week fs-3"></i>
                </div>
                <h5 class="fw-semibold mb-1">Armador Visual de Horarios</h5>
                <p class="text-muted small mb-0">Diseña tu horario de clases de 7:00 a.m. a 10:00 p.m., registra edificios, salones o laboratorios y evita traslapes.</p>
            </div>
        </a>
    </div>

    <div class="col-md-6">
        <div class="card-minimal p-4 h-100 bg-light border-dashed">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <i class="bi bi-stars fs-3 text-muted"></i>
                <span class="tech-badge bg-secondary-subtle text-secondary">En desarrollo</span>
            </div>
            <h5 class="fw-semibold mb-1 text-muted">Próximamente</h5>
            <p class="text-muted small mb-0">Más herramientas próximamente en GarAngelito Tools Pro.</p>
        </div>
    </div>
</div>