@{
    ViewData["Title"] = "Formateador APA 7";
}

<div id="app-apa" class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <span class="tech-badge bg-secondary-subtle text-secondary-emphasis mb-1 d-inline-block">Vue.js 3 + Vista SQL vw_ReferenciasApaFormateadas</span>
            <h3 class="fw-semibold mb-0">Biblioteca de Referencias APA 7 (3FN)</h3>
        </div>

        <div class="card-minimal p-4 mb-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small text-muted fw-medium">Tipo de fuente</label>
                    <select v-model="formulario.tipo" class="form-select">
                        <option value="libro">📖 Libro</option>
                        <option value="web">🌐 Sitio Web</option>
                        <option value="articulo">📄 Artículo</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted fw-medium">Apellido Paterno Autor (1FN)</label>
                    <input type="text" v-model="formulario.apellidoAutor" class="form-control" placeholder="Ej. García">
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted fw-medium">Inicial (1FN)</label>
                    <input type="text" v-model="formulario.inicialAutor" maxlength="2" class="form-control" placeholder="A.">
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted fw-medium">Año Publicación</label>
                    <input type="text" v-model="formulario.anio" class="form-control" placeholder="Ej. 2026">
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-muted fw-medium">Título de la obra</label>
                    <input type="text" v-model="formulario.titulo" class="form-control" placeholder="Ej. Sistemas Digitales">
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-muted fw-medium">Editorial, Revista o URL</label>
                    <input type="text" v-model="formulario.fuente" class="form-control" placeholder="Ej. Alfaomega o https://...">
                </div>
            </div>

            <div class="mt-3 pt-3 border-top d-flex flex-wrap gap-3 small">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkFecha" v-model="formulario.incluirFechaConsulta">
                    <label class="form-check-label text-muted" for="chkFecha">Anexar fecha de consulta</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkRecup" v-model="formulario.incluirRecuperadoDe">
                    <label class="form-check-label text-muted" for="chkRecup">Incluir "Recuperado de"</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkValAnio" v-model="formulario.validarAnioEstricto">
                    <label class="form-check-label text-muted" for="chkValAnio">Validación estricta de año</label>
                </div>
            </div>

            <div class="mt-4 d-flex justify-content-end">
                <button @@click="guardarEnSql" class="btn-dark-minimal">
                    <i class="bi bi-database-add me-1"></i> Guardar en Biblioteca SQL
                </button>
            </div>
        </div>

        <div class="card-minimal p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-semibold mb-0">Referencias en vw_ReferenciasApaFormateadas ({{ historial.length }})</h6>
                <button @@click="copiarSeleccionadas" class="btn btn-sm btn-outline-dark rounded-3">
                    <i class="bi bi-check2-all me-1"></i> Copiar las marcadas con Check
                </button>
            </div>
            <div class="d-flex flex-column gap-2">
                <div v-for="item in historial" :key="item.id" class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <input type="checkbox" class="form-check-input mt-0" :checked="item.seleccionada" @@change="toggleCheckSql(item)">
                        <span v-html="item.html" class="small"></span>
                    </div>
                    <button @@click="copiarTexto(item.html)" class="btn btn-sm btn-white border bg-white ms-3">
                        <i class="bi bi-clipboard"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    formulario: {
                        tipo: 'libro',
                        apellidoAutor: '',
                        inicialAutor: 'A.',
                        anio: '2026',
                        titulo: '',
                        fuente: '',
                        incluirFechaConsulta: false,
                        incluirRecuperadoDe: true,
                        validarAnioEstricto: true
                    },
                    historial: []
                }
            },
            methods: {
                async cargarDesdeVistaSql() {
                    const res = await fetch('/Home/ObtenerReferenciasApa');
                    this.historial = await res.json();
                },
                async guardarEnSql() {
                    window.UI.showLoader('Insertando en ReferenciasApa y AutoresReferenciaApa...');
                    const res = await fetch('/Home/CrearReferenciaApa', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(this.formulario)
                    });
                    const data = await res.json();
                    window.UI.hideLoader();

                    if (!res.ok) {
                        window.UI.showException('Error de Validación APA / SQL', data.error, data.codigo);
                        return;
                    }

                    window.UI.notify('Referencia Guardada en SQL', 'La vista vw_ReferenciasApaFormateadas calculó tu cita.', 'success');
                    this.formulario.titulo = '';
                    this.formulario.fuente = '';
                    await this.cargarDesdeVistaSql();
                },
                async toggleCheckSql(item) {
                    await fetch(`/Home/ToggleSeleccionApa?id=${item.id}`, { method: 'POST' });
                    await this.cargarDesdeVistaSql();
                },
                copiarTexto(html) {
                    const temp = document.createElement('div');
                    temp.innerHTML = html;
                    navigator.clipboard.writeText(temp.innerText);
                    window.UI.notify('Copiado al Portapapeles', 'Referencia individual copiada.', 'info', false);
                },
                copiarSeleccionadas() {
                    const marcadas = this.historial.filter(h => h.seleccionada);
                    if (marcadas.length === 0) {
                        window.UI.showException('Sin Referencias Marcadas', 'Marca con un check al menos una referencia.', 'ERR_NO_APA_CHECKED');
                        return;
                    }
                    const textoLimpio = marcadas.map(m => {
                        const temp = document.createElement('div');
                        temp.innerHTML = m.html;
                        return temp.innerText;
                    }).join('\n\n');

                    navigator.clipboard.writeText(textoLimpio);
                    window.UI.notify('Bibliografía Copiada', `Se copiaron ${marcadas.length} referencias desde SQL Server.`, 'success');
                }
            },
            mounted() {
                this.cargarDesdeVistaSql();
            }
        }).mount('#app-apa');
    </script>
}