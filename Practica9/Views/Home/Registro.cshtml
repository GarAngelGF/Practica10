@{
    ViewData["Title"] = "Registro";
}

<div id="app-registro" v-cloak class="row justify-content-center align-items-center py-4">
    <div class="col-md-7 col-lg-5">
        <div class="card-minimal p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h4 class="fw-semibold mb-1">Crear Cuenta en GarAngelito Tools Pro</h4>
                    <p class="text-muted small mb-0">Completa tus datos para registrarte en la plataforma</p>
                </div>
                <i class="bi bi-person-plus fs-3 text-dark"></i>
            </div>

            <form @@submit.prevent="registrarAlumno">
                <div class="row g-3 mb-3">
                    <div class="col-md-12">
                        <label class="form-label small text-muted fw-medium">Nombre(s) *</label>
                        <input type="text" v-model="form.nombre" class="form-control" placeholder="Ej. Ángel" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-muted fw-medium">Apellido Paterno *</label>
                        <input type="text" v-model="form.apellidoPaterno" class="form-control" placeholder="Ej. García" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-muted fw-medium">Apellido Materno</label>
                        <input type="text" v-model="form.apellidoMaterno" class="form-control" placeholder="Ej. Francisco">
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-12">
                        <label class="form-label small text-muted fw-medium">Correo Electrónico *</label>
                        <input type="email" v-model="form.correo" class="form-control" placeholder="correo@ejemplo.com" required>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label small text-muted fw-medium">Contraseña *</label>
                        <input type="password" v-model="form.password" class="form-control" placeholder="Mínimo 4 caracteres" required>
                    </div>
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" id="chkTerminos" v-model="aceptaCheck">
                    <label class="form-check-label small text-muted" for="chkTerminos">
                        Confirmo que mis datos son correctos para crear mi cuenta.
                    </label>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn-dark-minimal py-2" :disabled="cargando">
                        <span v-if="cargando" class="spinner-border spinner-border-sm me-2"></span>
                        {{ cargando ? 'Guardando...' : 'Guardar' }}
                    </button>
                </div>

                <div class="text-center border-top pt-3 small">
                    <span class="text-muted">¿Ya tienes una cuenta?</span>
                    <a asp-controller="Home" asp-action="Login" class="fw-semibold text-dark text-decoration-none ms-1">
                        Inicia Sesión aquí
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/frameworks/vue.global.js"></script>
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    form: {
                        nombre: '',
                        apellidoPaterno: '',
                        apellidoMaterno: '',
                        correo: '',
                        password: ''
                    },
                    aceptaCheck: false,
                    cargando: false
                }
            },
            methods: {
                async registrarAlumno() {
                    if (!this.aceptaCheck) {
                        window.UI.showException(
                            'Confirmación Requerida',
                            'Debes marcar la casilla de confirmación antes de guardar tu registro.',
                            'ERR_CHECK_TERMS_REQUIRED'
                        );
                        return;
                    }

                    if (this.form.password.length < 4) {
                        window.UI.showException(
                            'Contraseña Demasiado Corta',
                            'La contraseña debe tener al menos 4 caracteres.',
                            'ERR_WEAK_PASSWORD'
                        );
                        return;
                    }

                    this.cargando = true;
                    window.UI.showLoader('Guardando cuenta...');

                    try {
                        const res = await fetch('/Home/RegistrarEstudiante', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(this.form)
                        });
                        const data = await res.json();
                        window.UI.hideLoader();

                        if (!res.ok) {
                            window.UI.showException('Error al Registrar', data.error, data.codigo);
                            return;
                        }

                        window.UI.notify('Cuenta Creada', 'Registro exitoso. Ahora inicia sesión.', 'success', false);
                        setTimeout(() => {
                            window.location.href = data.redirectUrl;
                        }, 900);
                    } catch (e) {
                        window.UI.hideLoader();
                        window.UI.showException('Error de Red', 'No fue posible comunicarse con el servidor.', 'ERR_NET_REGISTER');
                    } finally {
                        this.cargando = false;
                    }
                }
            }
        }).mount('#app-registro');
    </script>
}