@{
    ViewData["Title"] = "Historial de Gastos por Calendario";
}

<div id="app-historial" v-cloak class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="tech-badge bg-secondary-subtle text-secondary mb-1 d-inline-block">Modo Solo Lectura</span>
                <h3 class="fw-semibold mb-0">Consulta de Gastos por Calendario</h3>
            </div>
            <a asp-action="Billetera" class="btn btn-light border btn-sm rounded-3">
                <i class="bi bi-arrow-left me-1"></i> Volver a Billetera
            </a>
        </div>

        <div class="card-minimal p-4 mb-4">
            <div class="row align-items-center g-3">
                <div class="col-md-6">
                    <label class="form-label small text-muted fw-medium mb-1">Selecciona un día en el calendario</label>
                    <input type="date" v-model="fechaSeleccionada" @@change="consultarFecha" class="form-control">
                </div>
                <div class="col-md-6 text-md-end">
                    <span class="text-muted small d-block">Total gastado en la fecha seleccionada</span>
                    <h2 class="fw-bold mb-0 text-dark">${{ totalFecha.toFixed(2) }}</h2>
                    <small class="text-muted">{{ movimientos.length }} movimiento(s) encontrados</small>
                </div>
            </div>
        </div>

        <div class="card-minimal p-4">
            <h6 class="fw-semibold mb-3">Movimientos registrados el {{ fechaSeleccionada }}</h6>

            <div v-if="movimientos.length === 0" class="text-center text-muted py-5 small">
                <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>
                No existen gastos registrados en esta fecha.
            </div>

            <div class="table-responsive" v-else>
                <table class="table align-middle mb-0">
                    <thead class="table-light small text-muted">
                        <tr>
                            <th>Hora</th>
                            <th>Concepto</th>
                            <th>Categoría</th>
                            <th>Estado</th>
                            <th class="text-end">Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="m in movimientos" :key="m.id">
                            <td class="small text-muted">{{ m.hora }}</td>
                            <td class="fw-medium">{{ m.concepto }}</td>
                            <td><span class="badge bg-light text-dark border">{{ m.categoria }}</span></td>
                            <td>
                                <span v-if="m.verificado" class="badge bg-success-subtle text-success">Pagado</span>
                                <span v-else class="badge bg-secondary-subtle text-secondary">Pendiente</span>
                            </td>
                            <td class="text-end fw-semibold text-danger">-${{ m.monto.toFixed(2) }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/frameworks/vue.global.js"></script>
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                const hoy = new Date();
                const yyyy = hoy.getFullYear();
                const mm = String(hoy.getMonth() + 1).padStart(2, '0');
                const dd = String(hoy.getDate()).padStart(2, '0');
                return {
                    fechaSeleccionada: `${yyyy}-${mm}-${dd}`,
                    movimientos: []
                }
            },
            computed: {
                totalFecha() {
                    return this.movimientos.reduce((acc, item) => acc + item.monto, 0);
                }
            },
            methods: {
                async consultarFecha() {
                    if (!this.fechaSeleccionada) return;
                    window.UI.showLoader('Consultando movimientos del día...');
                    const res = await fetch(`/Home/ObtenerGastosPorFecha?fecha=${this.fechaSeleccionada}`);
                    if (res.ok) {
                        this.movimientos = await res.json();
                    }
                    window.UI.hideLoader();
                }
            },
            mounted() {
                this.consultarFecha();
            }
        }).mount('#app-historial');
    </script>
}